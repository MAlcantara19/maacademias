# Copie este arquivo para .env.local e preencha com os dados do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave
# Domínios que mostram a página geral (separados por vírgula). Os outros
# domínios são tratados como domínio próprio de uma academia.
NEXT_PUBLIC_DOMINIOS_PRINCIPAIS=localhost,maacademias.vercel.app

# Notificações no celular (opcional). Gere as chaves com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:seu-email@gmail.com
# Chave SECRETA do Supabase (Project Settings → API Keys → Secret). Usada para criar logins
# e enviar push. Fica só no servidor (Vercel e .env.local), nunca no GitHub!
SUPABASE_SECRET_KEY=
# Uma senha qualquer que você inventa; a mesma vai no webhook do Supabase
PUSH_WEBHOOK_SECRET=

# Página de vendas (opcional)
NEXT_PUBLIC_WHATSAPP_VENDAS=5524999999999
NEXT_PUBLIC_DEMO_EMAIL=prof.piloto@example.com
NEXT_PUBLIC_DEMO_SENHA=

# Galeria pelo Google Drive (opcional): chave de API do Google Cloud com a "Google Drive API" ativada
GOOGLE_API_KEY=
